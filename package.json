{
  "scripts": {
    "build": "pnpm build:html && zile && node scripts/set-workspace-bin.js",
    "build:html": "node --import tsx scripts/build:html.ts",
    "changeset:publish:main": "zile publish:prepare && changeset publish --no-git-tag --tag main && zile publish:post",
    "changeset:publish": "zile publish:prepare && changeset publish && zile publish:post",
    "changeset:version": "changeset version && vp fmt .",
    "check": "vp lint --fix && vp fmt --write .",
    "check:ci": "vp lint && vp fmt --check .",
    "check:types": "pnpm build:html && tsgo -b",
    "check:types:html": "tsgo -p src/tempo/server/internal/html/tsconfig.json && tsgo -p src/stripe/server/internal/html/tsconfig.json",
    "check:types:examples": "pnpm -r --filter './examples/**' run check:types",
    "deps": "pnpx taze -r --no-ignore-other-workspaces --ignore-paths node_modules",
    "deps:ci": "pnpx actions-up",
    "dev": "zile dev && node scripts/set-workspace-bin.js",
    "dev:example": "node scripts/dev:example.ts",
    "mppx": "node --import tsx src/bin.ts",
    "test": "vp test",
    "test:html": "playwright test --config test/html/playwright.config.ts"
  },
  "browserslist": [
    "defaults",
    "not dead",
    "not op_mini all",
    "not kaios >= 0",
    "not android >= 0",
    "not and_uc >= 0",
    "not and_qq >= 0",
    "not and_ff >= 0",
    "node >= 18"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@x402/core": "2.22.0",
    "@x402/evm": "2.22.0",
    "@x402/express": "2.22.0",
    "browserslist": "^4.28.7",
    "elysia": "^1.4.29",
    "eslint-plugin-compat": "^7.0.2",
    "express": "^5.2.1",
    "fast-check": "^4.9.0",
    "file-type": "catalog:",
    "frog": "^1.0.15",
    "hono": "4.12.32",
    "isows": "^1.0.7",
    "playwright": "^1.62.1",
    "prool": "^0.2.14",
    "rolldown": "1.2.2",
    "tempo.ts": "^0.14.2",
    "testcontainers": "^12.0.4",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
