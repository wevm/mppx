{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mppx-charge-wagmi",
  "main": "server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The React page is served as static assets; /api/* always reaches the Worker.
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  // Used payments are recorded in Durable Objects, so a payment can't be
  // replayed against another isolate.
  "durable_objects": {
    "bindings": [{ "name": "MPPX_STORE", "class_name": "MppxStore" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MppxStore"] }],
}
