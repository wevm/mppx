{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mppx-session-multi-fetch",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // One Durable Object per payment channel holds its state, so every paid
  // request and the close see the same channel from any isolate, and
  // schedules its settlement.
  "durable_objects": {
    "bindings": [{ "name": "MPPX_STORE", "class_name": "MppxStore" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MppxStore"] }],
  // Channel objects send channels to settle here; the Worker's queue() settles them.
  "queues": {
    "producers": [{ "binding": "MPPX_SETTLEMENT_QUEUE", "queue": "mppx-settlements" }],
    "consumers": [{ "queue": "mppx-settlements" }],
  },
}
