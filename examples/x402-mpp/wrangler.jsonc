{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mppx-x402-mpp",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Durable Objects hold Tempo replay protection, so a credential spent on
  // one isolate can't be accepted again on another.
  "durable_objects": {
    "bindings": [{ "name": "MPPX_STORE", "class_name": "MppxStore" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MppxStore"] }],
}
