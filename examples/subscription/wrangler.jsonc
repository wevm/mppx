{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mppx-subscription",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Durable Objects hold subscriptions and their access keys, so every
  // request sees the same subscription from any isolate.
  "durable_objects": {
    "bindings": [{ "name": "MPPX_STORE", "class_name": "MppxStore" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MppxStore"] }],
}
